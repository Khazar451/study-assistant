# ==============================================================================
# Study Assistant Environment Configuration
# ==============================================================================

# --- Nebius Token Factory (Primary LLM Provider) ---
# When set, tutor answers, query augmentation and reranking run on NVIDIA Nemotron via Token Factory.
NEBIUS_API_KEY=your-nebius-token-factory-api-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Heavy model for derivations/proofs/calculations; falls back to NEBIUS_MODEL if unavailable.
NEBIUS_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
ENABLE_REASONING_ROUTER=true

# --- NVIDIA NIM (Embeddings, Vision, and LLM Fallback) ---
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# Only used when NEBIUS_API_KEY is not set
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Vector Database & Storage ---
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=study_assistant

# --- Web Search & Grounding (Optional) ---
TAVILY_API_KEY=tvly-your-tavily-api-key-here
ENABLE_WEB_SEARCH=false

# --- Public demo hardening (optional; leave unset for local development) ---
DEMO_MODE=false
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=0
# Proxies in front of the app that append to X-Forwarded-For (0 = use the connecting address)
TRUSTED_PROXY_HOPS=0
# Caps across all visitors together, and a switch that stops all model spending (0 / false = off)
DEMO_MAX_PER_MIN=0
DEMO_MAX_PER_DAY=0
DEMO_PAUSED=false
# Private chats per browser; leave unset to follow DEMO_MODE
# WORKSPACE_ISOLATION=true
# Nemotron 3 Ultra calls per hour before falling back to Super (0 = no cap)
ULTRA_MAX_PER_HOUR=0
MAX_UPLOAD_MB=200
# With workspace isolation: uploads in progress and files kept per visitor (0 = no limit)
# MAX_PENDING_UPLOADS=3
# MAX_FILES_PER_WORKSPACE=5
# Other sites allowed to call the API from a browser (comma-separated, or * for any). Empty = none;
# the bundled UI does not need it.
CORS_ORIGINS=
