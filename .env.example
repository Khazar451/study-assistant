# ==============================================================================
# Study Assistant Environment Configuration
# ==============================================================================

# --- NVIDIA NIM Configuration (Primary Provider) ---
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Nebius AI Studio Configuration (Resilience Fallback Provider) ---
NEBIUS_API_KEY=your-nebius-api-key-here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# --- Vector Database & Storage ---
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=study_assistant
